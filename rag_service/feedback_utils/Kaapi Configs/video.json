{
    "name": "Tap video assessment",
    "description": "assessment test with private videos",
    "tag": "ASSESSMENT",
    "config_blob": {
        "input_schema": {
                "artwork_video": {
                    "type": "video",
                    "format": "url"
                },
                "submission_id": {
                    "type": "text",
                    "format": null
                },
                "rendered_prompt": {
                    "type": "text",
                    "format": null
                }
            },
        "assessment": {
                "type": "text",
                "params": {
                    "model": "gemini-3.5-flash-lite",
                    "submission": "{rendered_prompt}\n\nReturn submission_id exactly as: {submission_id}",
                    "instructions": "Execute the grading prompt provided in the submission against the attached video. Follow that prompt's rubric and scoring exactly. Copy the given submission_id verbatim into the submission_id output field. Return output strictly matching the JSON schema.",
                    "json_output_schema": {
                        "type": "object",
                        "required": [
                            "submission_id",
                            "rubric_evaluations",
                            "overall_feedback",
                            "overall_feedback_translated",
                            "final_grade",
                            "submission_validity"
                        ],
                        "properties": {
                            "final_grade": {
                                "type": "integer",
                                "description": "0-100 overall grade"
                            },
                            "submission_id": {
                                "type": "string",
                                "description": "echo the input submission_id exactly as given"
                            },
                            "overall_feedback": {
                                "type": "string",
                                "description": "encouraging overall feedback"
                            },
                            "rubric_evaluations": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "Skill",
                                        "grade_value",
                                        "observation"
                                    ],
                                    "properties": {
                                        "Skill": {
                                            "type": "string",
                                            "description": "the rubric skill name"
                                        },
                                        "grade_value": {
                                            "type": "integer",
                                            "description": "1-5 grade for this skill"
                                        },
                                        "observation": {
                                            "type": "string",
                                            "description": "evidence-based reason"
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "description": "one entry per rubric skill named in the prompt"
                            },
                            "submission_validity": {
                                "type": "string",
                                "description": "validity of the submission, one of: valid or invalid"
                            },
                            "overall_feedback_translated": {
                                "type": "string",
                                "description": "overall feedback in the student's language as specified in the prompt"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "provider": "openai"
            }
    }
}